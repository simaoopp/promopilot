# Public links / email branding
APP_PUBLIC_URL=https://www.promopilot.pt
PROMOPILOT_EMAIL_LOGO_URL=https://www.promopilot.pt/logo192.png

# Supabase service role (worker only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
