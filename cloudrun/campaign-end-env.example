NODE_ENV=production

# Feature flag / scope
CAMPAIGN_END_EMAIL_ENABLED=1
CAMPAIGN_END_STORE_NAME=Loja da Praia
CAMPAIGN_END_WORKER_LIMIT=50
CAMPAIGN_END_MAX_ATTEMPTS=24
CAMPAIGN_END_EMAIL_TIMEOUT_MS=30000

# Resend
